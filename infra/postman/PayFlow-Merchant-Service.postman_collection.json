{
  "info": {
    "name": "PayFlow - Merchant Service",
    "_postman_id": "b2c3d4e5-f6a7-8901-bcde-f23456789012",
    "description": "Merchant Management APIs for PayFlow Payment Gateway",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-login if no token",
          "if (!pm.collectionVariables.get('accessToken')) {",
          "    pm.sendRequest({",
          "        url: pm.environment.get('baseUrl') + '/v1/auth/login',",
          "        method: 'POST',",
          "        header: { 'Content-Type': 'application/json' },",
          "        body: { mode: 'raw', raw: JSON.stringify({ email: 'merchant@testshop.com', password: 'Merchant@123456' }) }",
          "    }, function(err, res) {",
          "        if (!err && res.code === 200) {",
          "            const body = res.json();",
          "            pm.collectionVariables.set('accessToken', body.accessToken);",
          "        }",
          "    });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "accessToken", "value": "" },
    { "key": "merchantId", "value": "" },
    { "key": "apiKeyId", "value": "" },
    { "key": "webhookId", "value": "" }
  ],
  "item": [
    {
      "name": "Merchant Onboarding",
      "item": [
        {
          "name": "Onboard Merchant",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"businessName\": \"Test Store\",\n  \"businessType\": \"E_COMMERCE\",\n  \"registrationNumber\": \"REG-TEST-001\",\n  \"country\": \"IN\",\n  \"currency\": \"INR\",\n  \"website\": \"https://teststore.com\",\n  \"callbackUrl\": \"https://teststore.com/webhooks\",\n  \"contactEmail\": \"payments@teststore.com\",\n  \"contactPhone\": \"+919876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/merchants",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "merchants"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function() {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Merchant created with ID', function() {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('merchantId');",
                  "    pm.collectionVariables.set('merchantId', body.merchantId);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Merchant",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/merchants/{{merchantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "merchants", "{{merchantId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Merchant details returned', function() {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('businessName');",
                  "    pm.expect(body).to.have.property('status');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List Merchants",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/merchants?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "merchants"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Returns paginated list', function() {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('content');",
                  "    pm.expect(body).to.have.property('totalElements');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "API Keys",
      "item": [
        {
          "name": "Generate API Key",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Production Key\",\n  \"environment\": \"LIVE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/merchants/{{merchantId}}/api-keys",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "merchants", "{{merchantId}}", "api-keys"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function() {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('API key generated', function() {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('keyId');",
                  "    pm.expect(body).to.have.property('apiKey');",
                  "    pm.collectionVariables.set('apiKeyId', body.keyId);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List API Keys",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/merchants/{{merchantId}}/api-keys",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "merchants", "{{merchantId}}", "api-keys"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Revoke API Key",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/merchants/{{merchantId}}/api-keys/{{apiKeyId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "merchants", "{{merchantId}}", "api-keys", "{{apiKeyId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 204', function() {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Webhooks",
      "item": [
        {
          "name": "Register Webhook",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://teststore.com/webhooks/payflow\",\n  \"events\": [\"payment.captured\", \"payment.refunded\", \"settlement.completed\"],\n  \"secret\": \"whsec_testSecret123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/merchants/{{merchantId}}/webhooks",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "merchants", "{{merchantId}}", "webhooks"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function() {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Webhook registered', function() {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('webhookId');",
                  "    pm.collectionVariables.set('webhookId', body.webhookId);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List Webhooks",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/merchants/{{merchantId}}/webhooks",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "merchants", "{{merchantId}}", "webhooks"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
