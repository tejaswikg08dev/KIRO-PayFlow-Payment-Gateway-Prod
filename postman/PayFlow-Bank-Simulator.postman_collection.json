{
  "info": {
    "name": "PayFlow - Bank Simulator",
    "description": "Bank Simulator management endpoints (HTTP port 9000).\n\nThe bank simulator's core function is ISO 8583 over TCP on port 9090 — which can't be tested via Postman/HTTP.\nTo test the actual bank authorization, use the Routing Service collection (POST /internal/route).\n\nThese requests test the HTTP management/actuator layer only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:9000", "type": "string" },
    { "key": "routingUrl", "value": "http://localhost:8084", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Health & Monitoring (HTTP :9000)",
      "item": [
        {
          "name": "1.1 Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status is UP', () => {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.status).to.eql('UP');",
                  "});",
                  "console.log('Bank Simulator HTTP server is healthy');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/actuator/health", "host": ["{{baseUrl}}"], "path": ["actuator", "health"] }
          }
        },
        {
          "name": "1.2 Application Info",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/actuator/info", "host": ["{{baseUrl}}"], "path": ["actuator", "info"] }
          }
        },
        {
          "name": "1.3 Available Metrics",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/actuator/metrics", "host": ["{{baseUrl}}"], "path": ["actuator", "metrics"] }
          }
        }
      ]
    },
    {
      "name": "2. End-to-End via Routing Service (HTTP :8084)",
      "description": "These requests go through the Routing Service which connects to the Bank Simulator via TCP.\nRequires BOTH routing-service (:8084) AND bank-simulator (:9090) to be running.",
      "item": [
        {
          "name": "2.1 Test Card 4111 → Always APPROVE",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "var json = pm.response.json();",
                  "if (json.success) {",
                  "  pm.test('Approved', () => pm.expect(json.responseCode).to.eql('00'));",
                  "  console.log('✅ Card 4111 APPROVED as expected: authCode=' + json.authorizationCode);",
                  "} else {",
                  "  console.log('Response: ' + JSON.stringify(json));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantId\": \"merchant-001\",\n  \"amount\": 1500.00,\n  \"currency\": \"INR\",\n  \"paymentMethod\": \"CARD\",\n  \"cardBin\": \"411111\",\n  \"cardNumber\": \"4111111111111111\"\n}"
            },
            "url": { "raw": "{{routingUrl}}/internal/route", "host": ["{{routingUrl}}"], "path": ["internal", "route"] }
          }
        },
        {
          "name": "2.2 Test Card 5500 → Always APPROVE (Mastercard)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "var json = pm.response.json();",
                  "console.log('Mastercard 5500: success=' + json.success + ', code=' + json.responseCode);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantId\": \"merchant-001\",\n  \"amount\": 2000.00,\n  \"currency\": \"INR\",\n  \"paymentMethod\": \"CARD\",\n  \"cardBin\": \"550000\",\n  \"cardNumber\": \"5500000000000004\"\n}"
            },
            "url": { "raw": "{{routingUrl}}/internal/route", "host": ["{{routingUrl}}"], "path": ["internal", "route"] }
          }
        },
        {
          "name": "2.3 Test Card 4000 → Always DECLINE (Do Not Honor)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "var json = pm.response.json();",
                  "pm.test('Should be declined', () => pm.expect(json.success).to.eql(false));",
                  "console.log('❌ Card 4000 DECLINED as expected: code=' + json.responseCode + ', msg=' + json.responseMessage);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantId\": \"merchant-001\",\n  \"amount\": 1000.00,\n  \"currency\": \"INR\",\n  \"paymentMethod\": \"CARD\",\n  \"cardBin\": \"400000\",\n  \"cardNumber\": \"4000000000000002\"\n}"
            },
            "url": { "raw": "{{routingUrl}}/internal/route", "host": ["{{routingUrl}}"], "path": ["internal", "route"] }
          }
        },
        {
          "name": "2.4 Test Card 5400 → DECLINE (Invalid Card Number)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "var json = pm.response.json();",
                  "console.log('Card 5400: success=' + json.success + ', code=' + json.responseCode);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantId\": \"merchant-001\",\n  \"amount\": 500.00,\n  \"currency\": \"INR\",\n  \"paymentMethod\": \"CARD\",\n  \"cardBin\": \"540000\",\n  \"cardNumber\": \"5400000000000001\"\n}"
            },
            "url": { "raw": "{{routingUrl}}/internal/route", "host": ["{{routingUrl}}"], "path": ["internal", "route"] }
          }
        },
        {
          "name": "2.5 Test Card 4917 → DECLINE (Insufficient Funds)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "var json = pm.response.json();",
                  "console.log('Card 4917: success=' + json.success + ', code=' + json.responseCode);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantId\": \"merchant-001\",\n  \"amount\": 3000.00,\n  \"currency\": \"INR\",\n  \"paymentMethod\": \"CARD\",\n  \"cardBin\": \"491700\",\n  \"cardNumber\": \"4917000000000000\"\n}"
            },
            "url": { "raw": "{{routingUrl}}/internal/route", "host": ["{{routingUrl}}"], "path": ["internal", "route"] }
          }
        },
        {
          "name": "2.6 Random Card → 85% Approve / 15% Decline",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "var json = pm.response.json();",
                  "console.log('Random card: success=' + json.success + ', code=' + json.responseCode);",
                  "console.log('(Run this multiple times — ~85% should approve)');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantId\": \"merchant-001\",\n  \"amount\": 2500.00,\n  \"currency\": \"INR\",\n  \"paymentMethod\": \"CARD\",\n  \"cardBin\": \"777788\",\n  \"cardNumber\": \"7777888899990000\"\n}"
            },
            "url": { "raw": "{{routingUrl}}/internal/route", "host": ["{{routingUrl}}"], "path": ["internal", "route"] }
          }
        },
        {
          "name": "2.7 High Amount (₹2,00,000) → DECLINE (Exceeds Limit)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "var json = pm.response.json();",
                  "console.log('High amount test: success=' + json.success + ', code=' + json.responseCode);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantId\": \"merchant-001\",\n  \"amount\": 200000.00,\n  \"currency\": \"INR\",\n  \"paymentMethod\": \"CARD\",\n  \"cardBin\": \"777788\",\n  \"cardNumber\": \"7777888899990000\"\n}"
            },
            "url": { "raw": "{{routingUrl}}/internal/route", "host": ["{{routingUrl}}"], "path": ["internal", "route"] }
          }
        }
      ]
    }
  ]
}
