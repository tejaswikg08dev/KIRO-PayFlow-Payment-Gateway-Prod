{
  "info": {
    "name": "PayFlow - Payment Service",
    "description": "Core payment engine — Orders, Payments (authorize/capture/void), Refunds\n\nBase URL: http://localhost:8083\n\nFlow: Create Order → Authorize Payment → Capture → Refund",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8083", "type": "string" },
    { "key": "orderId", "value": "", "type": "string" },
    { "key": "paymentId", "value": "", "type": "string" },
    { "key": "refundId", "value": "", "type": "string" },
    { "key": "idempotencyKey", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Orders",
      "item": [
        {
          "name": "1.1 Create Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var json = pm.response.json();",
                  "  pm.collectionVariables.set('orderId', json.data.id);",
                  "  pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "  pm.test('Order ID starts with order_', () => pm.expect(json.data.id).to.match(/^order_/));",
                  "  pm.test('Status is CREATED', () => pm.expect(json.data.status).to.eql('CREATED'));",
                  "  pm.test('Has expiresAt', () => pm.expect(json.data.expiresAt).to.not.be.null);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantId\": \"merchant-001\",\n  \"amount\": 1500.00,\n  \"currency\": \"INR\",\n  \"customerEmail\": \"customer@example.com\",\n  \"description\": \"Premium Plan - 1 Year\",\n  \"receiptNumber\": \"REC-2024-001\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/orders", "host": ["{{baseUrl}}"], "path": ["v1", "orders"] }
          }
        },
        {
          "name": "1.2 Get Order by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "var json = pm.response.json();",
                  "pm.test('Correct order', () => pm.expect(json.data.id).to.eql(pm.collectionVariables.get('orderId')));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/v1/orders/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["v1", "orders", "{{orderId}}"] }
          }
        },
        {
          "name": "1.3 List Orders by Merchant",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/orders?merchantId=merchant-001",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "orders"],
              "query": [{ "key": "merchantId", "value": "merchant-001" }]
            }
          }
        },
        {
          "name": "1.4 Expire Stale Orders",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/v1/orders/expire", "host": ["{{baseUrl}}"], "path": ["v1", "orders", "expire"] }
          }
        },
        {
          "name": "1.5 Create Order — Validation Error (400)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 400', () => pm.response.to.have.status(400));"], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantId\": \"\",\n  \"amount\": -5,\n  \"currency\": \"INVALID\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/orders", "host": ["{{baseUrl}}"], "path": ["v1", "orders"] }
          }
        }
      ]
    },
    {
      "name": "2. Payments",
      "item": [
        {
          "name": "2.1 Authorize — CARD (with Idempotency)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('idempotencyKey', 'idem-' + pm.variables.replaceIn('{{$guid}}'));"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var json = pm.response.json();",
                  "  pm.collectionVariables.set('paymentId', json.data.id);",
                  "  pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "  pm.test('Payment ID starts with pay_', () => pm.expect(json.data.id).to.match(/^pay_/));",
                  "  pm.test('Status AUTHORIZED', () => pm.expect(json.data.status).to.eql('AUTHORIZED'));",
                  "  pm.test('Has authorizationCode', () => pm.expect(json.data.authorizationCode).to.not.be.null);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"paymentMethod\": \"CARD\",\n  \"cardNumber\": \"4111111111111111\",\n  \"cardCvv\": \"123\",\n  \"cardExpiryMonth\": \"12\",\n  \"cardExpiryYear\": \"2026\",\n  \"cardHolderName\": \"Tejaswi Kumar\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/payments/authorize", "host": ["{{baseUrl}}"], "path": ["v1", "payments", "authorize"] }
          }
        },
        {
          "name": "2.2 Authorize — Duplicate Idempotency Key (cached 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 (cached, not 201)', () => pm.response.to.have.status(200));",
                  "pm.test('Same payment ID (no double charge)', () => {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.data.id).to.eql(pm.collectionVariables.get('paymentId'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"paymentMethod\": \"CARD\",\n  \"cardNumber\": \"4111111111111111\",\n  \"cardCvv\": \"123\",\n  \"cardExpiryMonth\": \"12\",\n  \"cardExpiryYear\": \"2026\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/payments/authorize", "host": ["{{baseUrl}}"], "path": ["v1", "payments", "authorize"] }
          }
        },
        {
          "name": "2.3 Get Payment by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has payment details', () => {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.data.orderId).to.eql(pm.collectionVariables.get('orderId'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/v1/payments/{{paymentId}}", "host": ["{{baseUrl}}"], "path": ["v1", "payments", "{{paymentId}}"] }
          }
        },
        {
          "name": "2.4 Capture — Full Amount",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status CAPTURED', () => {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.data.status).to.eql('CAPTURED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentId\": \"{{paymentId}}\",\n  \"amount\": 1500.00\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/payments/capture", "host": ["{{baseUrl}}"], "path": ["v1", "payments", "capture"] }
          }
        },
        {
          "name": "2.5 Capture — Already Captured (422)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 422 (invalid state)', () => pm.response.to.have.status(422));"], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentId\": \"{{paymentId}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/payments/capture", "host": ["{{baseUrl}}"], "path": ["v1", "payments", "capture"] }
          }
        }
      ]
    },
    {
      "name": "3. Refunds",
      "item": [
        {
          "name": "3.1 Create Refund — Partial (₹500)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var json = pm.response.json();",
                  "  pm.collectionVariables.set('refundId', json.data.id);",
                  "  pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "  pm.test('Refund ID starts with rfnd_', () => pm.expect(json.data.id).to.match(/^rfnd_/));",
                  "  pm.test('Amount is 500', () => pm.expect(json.data.amount).to.eql(500));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentId\": \"{{paymentId}}\",\n  \"amount\": 500.00,\n  \"reason\": \"Customer returned one item\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/refunds", "host": ["{{baseUrl}}"], "path": ["v1", "refunds"] }
          }
        },
        {
          "name": "3.2 Create Refund — Over-Refund (422)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 422 (exceeds limit)', () => pm.response.to.have.status(422));"], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentId\": \"{{paymentId}}\",\n  \"amount\": 5000.00,\n  \"reason\": \"Trying to refund more than captured\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/refunds", "host": ["{{baseUrl}}"], "path": ["v1", "refunds"] }
          }
        },
        {
          "name": "3.3 Get Refund by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/v1/refunds/{{refundId}}", "host": ["{{baseUrl}}"], "path": ["v1", "refunds", "{{refundId}}"] }
          }
        },
        {
          "name": "3.4 List Refunds by Payment",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/refunds?paymentId={{paymentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "refunds"],
              "query": [{ "key": "paymentId", "value": "{{paymentId}}" }]
            }
          }
        }
      ]
    },
    {
      "name": "4. Void Flow (Separate Order)",
      "item": [
        {
          "name": "4.1 Create Order for Void Test",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('orderId', pm.response.json().data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantId\": \"merchant-001\",\n  \"amount\": 800.00,\n  \"currency\": \"INR\",\n  \"description\": \"Void test order\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/orders", "host": ["{{baseUrl}}"], "path": ["v1", "orders"] }
          }
        },
        {
          "name": "4.2 Authorize for Void Test",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('paymentId', pm.response.json().data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"paymentMethod\": \"UPI\",\n  \"upiId\": \"customer@oksbi\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/payments/authorize", "host": ["{{baseUrl}}"], "path": ["v1", "payments", "authorize"] }
          }
        },
        {
          "name": "4.3 Void Payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status VOIDED', () => pm.expect(pm.response.json().data.status).to.eql('VOIDED'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/v1/payments/{{paymentId}}/void", "host": ["{{baseUrl}}"], "path": ["v1", "payments", "{{paymentId}}", "void"] }
          }
        }
      ]
    },
    {
      "name": "5. Health Check",
      "item": [
        {
          "name": "Health",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/actuator/health", "host": ["{{baseUrl}}"], "path": ["actuator", "health"] } }
        }
      ]
    }
  ]
}
