{
  "info": {
    "name": "PayFlow - Routing Service",
    "description": "Internal transaction routing API — Fraud Detection, Smart Routing, ISO 8583, Bank Communication\n\nBase URL: http://localhost:8084\n\nThis service is called internally by Payment Service via Feign. These requests simulate that Feign call.\n\nFlow: Fraud Check → Smart Route Selection → ISO 8583 Build → Netty TCP to Bank → Parse Response → Record Metrics",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8084", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Health & Monitoring",
      "item": [
        {
          "name": "1.1 Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status is UP', () => {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.status).to.eql('UP');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/actuator/health", "host": ["{{baseUrl}}"], "path": ["actuator", "health"] }
          }
        },
        {
          "name": "1.2 Circuit Breaker Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/actuator/circuitbreakers", "host": ["{{baseUrl}}"], "path": ["actuator", "circuitbreakers"] }
          }
        },
        {
          "name": "1.3 Circuit Breaker Events",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/actuator/circuitbreakerevents", "host": ["{{baseUrl}}"], "path": ["actuator", "circuitbreakerevents"] }
          }
        },
        {
          "name": "1.4 Metrics",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/actuator/metrics", "host": ["{{baseUrl}}"], "path": ["actuator", "metrics"] }
          }
        }
      ]
    },
    {
      "name": "2. Route Transactions — Normal",
      "item": [
        {
          "name": "2.1 Route — Normal Card Payment (₹1,500 INR, Visa)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "var json = pm.response.json();",
                  "pm.test('Has responseCode', () => pm.expect(json.responseCode).to.not.be.undefined);",
                  "pm.test('Has bankId', () => pm.expect(json.bankId).to.not.be.null);",
                  "if (json.success) {",
                  "  pm.test('Approved — has authorizationCode', () => pm.expect(json.authorizationCode).to.not.be.null);",
                  "  pm.test('Response code 00', () => pm.expect(json.responseCode).to.eql('00'));",
                  "  console.log('✅ APPROVED: authCode=' + json.authorizationCode + ', bank=' + json.bankId + ', latency=' + json.latencyMs + 'ms');",
                  "} else {",
                  "  console.log('❌ DECLINED/ERROR: code=' + json.responseCode + ', message=' + json.responseMessage);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantId\": \"merchant-001\",\n  \"amount\": 1500.00,\n  \"currency\": \"INR\",\n  \"paymentMethod\": \"CARD\",\n  \"cardBin\": \"411111\",\n  \"cardNumber\": \"4111111111111111\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/internal/route", "host": ["{{baseUrl}}"], "path": ["internal", "route"] }
          }
        },
        {
          "name": "2.2 Route — Small Amount (₹500, low fraud risk)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "console.log('Response: ' + pm.response.text());"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantId\": \"merchant-002\",\n  \"amount\": 500.00,\n  \"currency\": \"USD\",\n  \"paymentMethod\": \"DEBIT_CARD\",\n  \"cardBin\": \"411111\",\n  \"cardNumber\": \"4111111111111111\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/internal/route", "host": ["{{baseUrl}}"], "path": ["internal", "route"] }
          }
        },
        {
          "name": "2.3 Route — Mastercard Payment (₹3,000 EUR)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantId\": \"merchant-003\",\n  \"amount\": 3000.00,\n  \"currency\": \"EUR\",\n  \"paymentMethod\": \"CREDIT_CARD\",\n  \"cardBin\": \"550000\",\n  \"cardNumber\": \"5500000000000004\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/internal/route", "host": ["{{baseUrl}}"], "path": ["internal", "route"] }
          }
        }
      ]
    },
    {
      "name": "3. Route Transactions — Fraud Triggers",
      "item": [
        {
          "name": "3.1 Fraud — High Amount (₹5,00,000 + Prepaid card)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "var json = pm.response.json();",
                  "console.log('Fraud test — High amount + Prepaid:');",
                  "console.log('  success=' + json.success + ', code=' + json.responseCode);",
                  "console.log('  message=' + json.responseMessage);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantId\": \"merchant-001\",\n  \"amount\": 500000.00,\n  \"currency\": \"INR\",\n  \"paymentMethod\": \"PREPAID\",\n  \"cardBin\": \"600000\",\n  \"cardNumber\": \"6000000000000000\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/internal/route", "host": ["{{baseUrl}}"], "path": ["internal", "route"] }
          }
        },
        {
          "name": "3.2 Fraud — Sanctioned Country (North Korean Won)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "var json = pm.response.json();",
                  "pm.test('Should be declined', () => pm.expect(json.success).to.eql(false));",
                  "pm.test('Response code 59 (Suspected Fraud)', () => pm.expect(json.responseCode).to.eql('59'));",
                  "console.log('🚫 Geo-blocked: ' + json.responseMessage);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantId\": \"merchant-suspicious\",\n  \"amount\": 10000.00,\n  \"currency\": \"KPW\",\n  \"paymentMethod\": \"CARD\",\n  \"cardBin\": \"411111\",\n  \"cardNumber\": \"4111111111111111\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/internal/route", "host": ["{{baseUrl}}"], "path": ["internal", "route"] }
          }
        },
        {
          "name": "3.3 Fraud — Iranian Rial (Sanctioned)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "var json = pm.response.json();",
                  "pm.test('Declined for fraud', () => pm.expect(json.success).to.eql(false));",
                  "pm.test('Code 59', () => pm.expect(json.responseCode).to.eql('59'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantId\": \"merchant-iran\",\n  \"amount\": 5000.00,\n  \"currency\": \"IRR\",\n  \"paymentMethod\": \"CARD\",\n  \"cardBin\": \"411111\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/internal/route", "host": ["{{baseUrl}}"], "path": ["internal", "route"] }
          }
        },
        {
          "name": "3.4 Fraud — Huge Amount (₹10,00,000, should DECLINE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "var json = pm.response.json();",
                  "console.log('₹10L transaction: success=' + json.success + ', code=' + json.responseCode);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantId\": \"merchant-001\",\n  \"amount\": 1000000.00,\n  \"currency\": \"INR\",\n  \"paymentMethod\": \"PREPAID\",\n  \"cardBin\": \"600000\",\n  \"cardNumber\": \"6000000000000000\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/internal/route", "host": ["{{baseUrl}}"], "path": ["internal", "route"] }
          }
        }
      ]
    },
